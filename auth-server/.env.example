# Production env vars for auth-server (see README.md). For local dev, use
# config.local.json (copied from config.local.json.example) instead — these
# process.env values take priority over that file when both are present.

PORT=4200
FIREBASE_PROJECT_ID=managerx-bac3a

# Full Firebase service-account key JSON (Console > Project Settings >
# Service Accounts > Generate new private key), minified to one line. Never
# commit a real value for this.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"managerx-bac3a", ...}

# Resend API key used to send the OTP email. Never commit a real value.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

RESEND_FROM_ADDRESS=support@froshiar.store

# Server-only secret mixed into every OTP hash. Generate with e.g.
# `openssl rand -hex 32`. Never commit a real value.
OTP_HASH_PEPPER=replace-with-a-long-random-string
