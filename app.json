{
  "expo": {
    "name": "Froshiar",
    "slug": "managerx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-icon.png",
    "scheme": "froshiar",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logo-splash-white.png",
      "resizeMode": "contain",
      "backgroundColor": "#181917"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.froshiar.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "We need access to your photos to upload your business logo.",
        "NSCameraUsageDescription": "We need camera access to take your business logo photo.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.froshiar.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAuth",
              "RNFBFirestore"
            ]
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "ndkVersion": "28.2.13676358",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.google.android.gms.auth.** { *; }\n-keep class com.google.android.gms.common.** { *; }\n-keep class com.google.android.gms.signin.** { *; }\n-keep class com.google.android.gms.internal.auth** { *; }\n-keep class com.google.android.gms.internal.identity** { *; }\n-dontwarn com.google.android.gms.**"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      "./plugins/withFirebaseAppDelegate",
      "expo-router",
      "expo-dev-client",
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Froshiar needs access to your photos to upload a business logo.",
          "cameraPermission": "Froshiar needs camera access to take a business logo photo.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2338ad90-88ee-4cd7-9ce9-29db5a56148e"
      }
    },
    "owner": "tebinfaruq"
  }
}
