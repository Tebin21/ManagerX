rules_version = '2';

// Every user's cloud data lives under users/{uid}. A signed-in user may only
// read/write the subtree that matches their own Firebase Auth uid — this is
// the sole authorization check for the whole database, enforced server-side
// (client code must never be trusted for this). See lib/cloudSync/ for the
// app code that writes here, and store/authStore.ts for how uid is derived
// from Firebase Auth.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // App telemetry: device installs and open counts
    match /app_telemetry_installs/{deviceId} {
      allow read, write: if true;
    }

    // App telemetry: user profiles, logins and device associations
    match /app_telemetry_users/{userId} {
      allow read, write: if true;
    }

    // App telemetry: live event stream
    match /app_telemetry_events/{eventId} {
      allow read, write: if true;
    }

    // Offline licenses and store subscriptions
    match /licenses/{licenseId} {
      allow read, write: if true;
    }

    match /online_store_subscriptions/{subId} {
      allow read, write: if true;
    }

    // Online store activations, subdomains and standalone storefronts
    match /store_activations/{storeId} {
      allow read, write: if true;
    }

    // Payment requests & user email-based subscriptions
    match /payment_requests/{reqId} {
      allow read, write: if true;
    }

    match /user_subscriptions/{subId} {
      allow read, write: if true;
    }

    // Employee accounts and RBAC permissions
    match /employee_accounts/{empId} {
      allow read, write: if true;
    }

    // Manager Google Drive sync links
    match /manager_drive_links/{linkId} {
      allow read, write: if true;
    }

    // App-wide configuration (Hero banner, announcements, typewriter phrases)
    match /app_config/{configId} {
      allow read, write: if true;
    }

    // User-specific banner and video custom configuration
    match /user_banner_configs/{docId} {
      allow read, write: if true;
    }

    // Website telemetry: visitor sessions and clickstream events
    match /website_visitors/{sessionId} {
      allow read, write: if true;
    }

    match /website_events/{eventId} {
      allow read, write: if true;
    }
  }
}
